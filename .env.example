# ── LLM (Hybrid: Gemini hooks + OpenAI planner) ───────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_PLANNER_MODEL=gpt-4o-mini
# Optional premium (not used by default)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── Live web facts (Tavily – primary search for card script) ──
TAVILY_API_KEY=your_tavily_api_key_here
# Only fetch news from the last N days (default 30)
TAVILY_DAYS=7
# When true and TAVILY_API_KEY is set, DuckDuckGo fallback is disabled
TAVILY_SKIP_DDG_FALLBACK=true
# Optional fallback if Tavily returns empty
# SERPAPI_API_KEY=your_serpapi_api_key_here

# ── Image backgrounds (Fal Flux Schnell primary) ──────────────
FAL_KEY=your_fal_api_key_here
PEXELS_API_KEY=your_pexels_api_key_here

# ── Assets (optional extras) ─────────────────────────────────
# Google Programmable Search (Custom Search JSON API) – CC filtered images
GOOGLE_CSE_API_KEY=your_google_cse_api_key
GOOGLE_CSE_CX=your_search_engine_id
# OpenAI image (optional legacy – not used by default)
# OPENAI_API_KEY is set above for planner – reuse same key
# Optional Unsplash (Tier-1 web photo boost)
# UNSPLASH_ACCESS_KEY=

# ── Instagram (Module 6) ─────────────────────────────────────
# Option A: Instagrapi (unofficial – dev/test only)
INSTAGRAM_USERNAME=your_username
INSTAGRAM_PASSWORD=your_password
INSTAGRAM_SESSION_PATH=./config/instagram_session.json

# Option B: Meta Graph API (production – recommended for B2B)
# META_ACCESS_TOKEN=your_meta_access_token
# INSTAGRAM_BUSINESS_ACCOUNT_ID=your_ig_business_account_id

# Upload mode: "manual" | "instagrapi" | "graph_api"
PUBLISH_MODE=manual

# Production mode default (overridden in Streamlit UI):
# voice_tts | music_caption
# PRODUCTION_MODE=voice_tts

# ── TTS (Module 3) ──────────────────────────────────────────
TTS_VOICE=ko-KR-SunHiNeural
TTS_RATE=-5%
TTS_PITCH=+2Hz
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# ── Assembly (Module 5) ─────────────────────────────────────
WHISPER_MODEL=base
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
OUTPUT_FPS=30

# BGM ducking levels (0.0 – 1.0) – keep underlay audible
BGM_VOLUME_NORMAL=0.28
BGM_VOLUME_DUCKED=0.18

# ── Paths ───────────────────────────────────────────────────
PROJECTS_DIR=./projects
SFX_DIR=./config/sfx
BRAND_CONFIG=./config/brand.yaml

# ── Research (Module 1) ─────────────────────────────────────
# Comma-separated RSS feed URLs (topic-specific Google News search is always added)
NEWS_RSS_FEEDS=https://news.google.com/rss?hl=ko&gl=KR&ceid=KR:ko
